# ==============================================================================
# SamadhanX Environment Configuration (Template)
# SIH 2026 - Problem Statement: SIH 26043
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Environment
# ------------------------------------------------------------------------------
PROJECT_NAME="SamadhanX"
VERSION="0.1.0"
# Set to 'production' for VPS deployment, 'development' for local
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. Security
# ------------------------------------------------------------------------------
# REQUIRED: In production, generate a secure 64-char key (e.g., `openssl rand -hex 32`)
# Value must be at least 32 characters long and not contain 'dev' or 'insecure'
SECRET_KEY="samadhanx-dev-insecure-secret-key-change-in-production-min-32-chars"

# ------------------------------------------------------------------------------
# 3. Frontend URL & CORS Origins
# ------------------------------------------------------------------------------
FRONTEND_URL="http://localhost:5173"
# In production, include your Vercel frontend URL (e.g. ["https://samadhanx.vercel.app"])
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# 4. Host Machine Port Mappings (Local Development Only)
# Note: In production docker-compose.prod.yml, postgres/redis ports are internal only!
# Backend is mapped strictly to 127.0.0.1:8001:8000
# ------------------------------------------------------------------------------
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8001
FRONTEND_PORT=5173

# ------------------------------------------------------------------------------
# 5. PostgreSQL Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=samadhanx

# ------------------------------------------------------------------------------
# 6. Database Connection URLs (Used for local direct runs if applicable)
# In Docker Compose, these are constructed automatically from the credentials above
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/samadhanx"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/samadhanx"

# ------------------------------------------------------------------------------
# 7. Redis & Celery Configuration
# In production, REDIS_PASSWORD is required for authenticated access
# ------------------------------------------------------------------------------
REDIS_PASSWORD=""
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# ------------------------------------------------------------------------------
# 8. AI & LLM Service Configuration
# ------------------------------------------------------------------------------
GROQ_API_KEY=""

# ------------------------------------------------------------------------------
# 9. Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_URL=""

# ------------------------------------------------------------------------------
# 10. Email & SMTP Configuration
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=true
EMAILS_FROM_EMAIL="noreply@samadhanx.in"
EMAILS_FROM_NAME="SamadhanX Platform"
EMAILS_ENABLED=false

# ------------------------------------------------------------------------------
# 11. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL="http://localhost:8001"

