# ==============================================================================
# SamadhanX Environment Configuration (Template)
# SIH 2026 - Problem Statement: SIH 26043
# ==============================================================================

# Project & Environment
PROJECT_NAME="SamadhanX"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Security (MUST be changed in production, min 32 chars)
SECRET_KEY="samadhanx-dev-insecure-secret-key-change-in-production-min-32-chars"

# CORS Allowed Origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Port configuration on Host machine (Custom ports prevent collisions with other local containers)
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8001
FRONTEND_PORT=5173

# PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=samadhanx

# Backend Database URLs (Internal Docker network connects to postgres:5432)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/samadhanx"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/samadhanx"

# Redis Configuration (Internal Docker network connects to redis:6379)
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# Frontend Environment (Vite points to backend port on host)
VITE_API_URL="http://localhost:8001"
