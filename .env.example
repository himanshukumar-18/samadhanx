# ==============================================================================
# SamadhanX Environment Configuration (Template)
# SIH 2026 - Problem Statement: SIH 26043
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the credentials for your environment.
# 3. NEVER commit .env to version control.
# ==============================================================================

# Project & Environment
PROJECT_NAME="SamadhanX"
VERSION="0.1.0"
ENVIRONMENT="development" # Options: development, test, staging, production
DEBUG=true
LOG_LEVEL="INFO"

# Security (MUST be changed in production, min 32 chars)
SECRET_KEY="samadhanx-dev-insecure-secret-key-change-in-production-min-32-chars"

# CORS Allowed Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL + pgvector Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=samadhanx

# Backend Database URLs
# For Docker internal networking (service name 'postgres')
DATABASE_URL="postgresql+asyncpg://postgres:postgres@postgres:5432/samadhanx"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@postgres:5432/samadhanx"

# For Host-only development outside Docker (uncomment if running uvicorn on host):
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/samadhanx"
# SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/samadhanx"

# Redis Configuration (Broker, Backend & Cache)
REDIS_URL="redis://redis:6379/0"
# For Host-only development outside Docker:
# REDIS_URL="redis://localhost:6379/0"

# Celery Configuration
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# Frontend Environment (Vite)
VITE_API_URL="http://localhost:8000"
