# Environment & General Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME=SamadhanX
VERSION=0.1.0
SECRET_KEY=samadhanx-dev-secret-key-do-not-use-in-production-min-32-chars

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/samadhanx
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/samadhanx

# Redis & Celery Task Queue Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Media Uploads (Cloudinary Service)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# SMTP Email Sending Configuration
EMAILS_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@samadhanx.in
EMAILS_FROM_NAME="SamadhanX Community Platform"


# AI Engine & Automation Layer Configuration (Groq development provider)
GROQ_API_KEY=your_groq_api_key_here
AI_ENABLED=true
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_INPUT_LENGTH=6000
AI_MAX_OUTPUT_TOKENS=1000
AI_TEMPERATURE=0
AI_CONFIDENCE_THRESHOLD=0.70
AI_SPAM_REVIEW_THRESHOLD=0.80
AI_HIGH_RISK_THRESHOLD=0.70
AI_MANUAL_REANALYSIS_ENABLED=true
AI_MANUAL_REANALYSIS_COOLDOWN_SECONDS=60
AI_PROMPT_VERSION=v1
